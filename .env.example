# auto preserves compatibility with earlier project versions: it uses configured
# Google Apps Script first, then configured SMTP, otherwise offers an email-app fallback.
# You may also set MAIL_PROVIDER=apps-script or MAIL_PROVIDER=smtp explicitly.
MAIL_PROVIDER=auto
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_APPS_SCRIPT_TOKEN=replace_with_the_same_long_random_secret_set_in_apps_script
CONTACT_TO_EMAIL=sumitpanchal5225@gmail.com
PORT=3001

# Optional alternative: Gmail SMTP (set MAIL_PROVIDER=smtp to use this instead).
# Requires a valid Google App Password belonging to SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sumitpanchal5225@gmail.com
SMTP_PASS=replace_with_your_16_character_google_app_password
